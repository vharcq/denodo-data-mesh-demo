# Copy to demo.env (git-ignored) and adapt. Every key is required.

# Denodo Virtual DataPort server. The CSV sources in data/ are read by the VDP server
# itself (LocalConnection), so the server must run on this machine, or see this folder
# under the same absolute path.
VDP_HOST=localhost
# JDBC port: used by run_demo.py
VDP_PORT=9999
# PostgreSQL-compatible port: used by dbt (the dbt-denodo adapter speaks psycopg2)
VDP_ODBC_PORT=9996
# An administrator account: the demo creates databases, roles, users and policies
VDP_USER=admin
VDP_PASS=admin

# Official Denodo JDBC driver, not redistributed here.
# Found in <DENODO_HOME>/tools/client-drivers/jdbc/denodo-vdp-jdbcdriver.jar
VDP_JDBC_JAR=drivers/denodo-vdp-jdbcdriver.jar

# Password of the 7 fictitious demo users (buyer_blue, rep_alice, ...).
# Denodo's default password policy wants upper + lower case, a digit, a special
# character, and no 3 consecutive digits.
DEMO_USERS_PASSWORD=Mesh-Demo-4u!
