-- chinook_security_staging: identity mappings (login -> labels / customers), internal, never exposed.
-- GENERATED by gen_csv_vql.py from data/*.csv. Do not edit by hand.
-- Staging layer: DF/CSV datasources + typed base views (I18N us_pst).
-- @DATA_DIR@ is replaced by run_demo.py with the absolute path of data/.
CONNECT DATABASE chinook_security_staging;

CREATE OR REPLACE FOLDER '/10 Datasources';
CREATE OR REPLACE FOLDER '/20 Base views';

-- buyer_label  <- data/buyer_label.csv
CREATE OR REPLACE DATASOURCE DF ds_buyer_label
    FOLDER = '/10 Datasources'
    ROUTE LOCAL 'LocalConnection' '@DATA_DIR@/buyer_label.csv' FILENAMEPATTERN = ''
    CHARSET = 'UTF-8' COLUMNDELIMITER = ',' ENDOFLINEDELIMITER = '\n' HEADER = TRUE;

CREATE OR REPLACE WRAPPER DF ds_buyer_label
    FOLDER = '/10 Datasources'
    DATASOURCENAME=ds_buyer_label
    OUTPUTSCHEMA (
        username = '"username"',
        label_id = '"label_id"'
    );

CREATE OR REPLACE TABLE bv_buyer_label I18N us_pst (
        username:text,
        label_id:int
    )
    FOLDER = '/20 Base views'
    CACHE OFF TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_buyer_label (
        I18N us_pst
        CONSTRAINTS (
             ADD username NOS ZERO ()
             ADD label_id NOS ZERO ()
        )
        OUTPUTLIST (username, label_id)
        WRAPPER (df ds_buyer_label)
    );

-- salesrep_customer  <- data/salesrep_customer.csv
CREATE OR REPLACE DATASOURCE DF ds_salesrep_customer
    FOLDER = '/10 Datasources'
    ROUTE LOCAL 'LocalConnection' '@DATA_DIR@/salesrep_customer.csv' FILENAMEPATTERN = ''
    CHARSET = 'UTF-8' COLUMNDELIMITER = ',' ENDOFLINEDELIMITER = '\n' HEADER = TRUE;

CREATE OR REPLACE WRAPPER DF ds_salesrep_customer
    FOLDER = '/10 Datasources'
    DATASOURCENAME=ds_salesrep_customer
    OUTPUTSCHEMA (
        username = '"username"',
        customer_id = '"customer_id"'
    );

CREATE OR REPLACE TABLE bv_salesrep_customer I18N us_pst (
        username:text,
        customer_id:int
    )
    FOLDER = '/20 Base views'
    CACHE OFF TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_salesrep_customer (
        I18N us_pst
        CONSTRAINTS (
             ADD username NOS ZERO ()
             ADD customer_id NOS ZERO ()
        )
        OUTPUTLIST (username, customer_id)
        WRAPPER (df ds_salesrep_customer)
    );
