-- chinook_sales_staging: raw layer of the sales, NOT exposed (no consumer access).
-- GENERATED by gen_csv_vql.py from data/*.csv. Do not edit by hand.
-- Staging layer: DF/CSV datasources + typed base views (I18N us_pst).
-- @DATA_DIR@ is replaced by run_demo.py with the absolute path of data/.
CONNECT DATABASE chinook_sales_staging;

CREATE OR REPLACE FOLDER '/10 Datasources';
CREATE OR REPLACE FOLDER '/20 Base views';

-- customer  <- data/customer.csv
CREATE OR REPLACE DATASOURCE DF ds_customer
    FOLDER = '/10 Datasources'
    ROUTE LOCAL 'LocalConnection' '@DATA_DIR@/customer.csv' FILENAMEPATTERN = ''
    CHARSET = 'UTF-8' COLUMNDELIMITER = ',' ENDOFLINEDELIMITER = '\n' HEADER = TRUE;

CREATE OR REPLACE WRAPPER DF ds_customer
    FOLDER = '/10 Datasources'
    DATASOURCENAME=ds_customer
    OUTPUTSCHEMA (
        customer_id = '"customer_id"',
        customer_name = '"customer_name"',
        email = '"email"'
    );

CREATE OR REPLACE TABLE bv_customer I18N us_pst (
        customer_id:int,
        customer_name:text,
        email:text
    )
    FOLDER = '/20 Base views'
    CACHE OFF TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_customer (
        I18N us_pst
        CONSTRAINTS (
             ADD customer_id NOS ZERO ()
             ADD customer_name NOS ZERO ()
             ADD email NOS ZERO ()
        )
        OUTPUTLIST (customer_id, customer_name, email)
        WRAPPER (df ds_customer)
    );

-- invoice  <- data/invoice.csv
CREATE OR REPLACE DATASOURCE DF ds_invoice
    FOLDER = '/10 Datasources'
    ROUTE LOCAL 'LocalConnection' '@DATA_DIR@/invoice.csv' FILENAMEPATTERN = ''
    CHARSET = 'UTF-8' COLUMNDELIMITER = ',' ENDOFLINEDELIMITER = '\n' HEADER = TRUE;

CREATE OR REPLACE WRAPPER DF ds_invoice
    FOLDER = '/10 Datasources'
    DATASOURCENAME=ds_invoice
    OUTPUTSCHEMA (
        invoice_id = '"invoice_id"',
        customer_id = '"customer_id"'
    );

CREATE OR REPLACE TABLE bv_invoice I18N us_pst (
        invoice_id:int,
        customer_id:int
    )
    FOLDER = '/20 Base views'
    CACHE OFF TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_invoice (
        I18N us_pst
        CONSTRAINTS (
             ADD invoice_id NOS ZERO ()
             ADD customer_id NOS ZERO ()
        )
        OUTPUTLIST (invoice_id, customer_id)
        WRAPPER (df ds_invoice)
    );

-- invoice_line  <- data/invoice_line.csv
CREATE OR REPLACE DATASOURCE DF ds_invoice_line
    FOLDER = '/10 Datasources'
    ROUTE LOCAL 'LocalConnection' '@DATA_DIR@/invoice_line.csv' FILENAMEPATTERN = ''
    CHARSET = 'UTF-8' COLUMNDELIMITER = ',' ENDOFLINEDELIMITER = '\n' HEADER = TRUE;

CREATE OR REPLACE WRAPPER DF ds_invoice_line
    FOLDER = '/10 Datasources'
    DATASOURCENAME=ds_invoice_line
    OUTPUTSCHEMA (
        line_id = '"line_id"',
        invoice_id = '"invoice_id"',
        track_id = '"track_id"',
        quantity = '"quantity"'
    );

CREATE OR REPLACE TABLE bv_invoice_line I18N us_pst (
        line_id:int,
        invoice_id:int,
        track_id:int,
        quantity:int
    )
    FOLDER = '/20 Base views'
    CACHE OFF TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_invoice_line (
        I18N us_pst
        CONSTRAINTS (
             ADD line_id NOS ZERO ()
             ADD invoice_id NOS ZERO ()
             ADD track_id NOS ZERO ()
             ADD quantity NOS ZERO ()
        )
        OUTPUTLIST (line_id, invoice_id, track_id, quantity)
        WRAPPER (df ds_invoice_line)
    );
