-- chinook_music_staging: raw layer of the catalogue, NOT exposed (no consumer access).
-- GENERATED by gen_csv_vql.py from data/*.csv. Do not edit by hand.
-- Staging layer: DF/CSV datasources + typed base views (I18N us_pst).
-- @DATA_DIR@ is replaced by run_demo.py with the absolute path of data/.
CONNECT DATABASE chinook_music_staging;

CREATE OR REPLACE FOLDER '/10 Datasources';
CREATE OR REPLACE FOLDER '/20 Base views';

-- label  <- data/label.csv
CREATE OR REPLACE DATASOURCE DF ds_label
    FOLDER = '/10 Datasources'
    ROUTE LOCAL 'LocalConnection' '@DATA_DIR@/label.csv' FILENAMEPATTERN = ''
    CHARSET = 'UTF-8' COLUMNDELIMITER = ',' ENDOFLINEDELIMITER = '\n' HEADER = TRUE;

CREATE OR REPLACE WRAPPER DF ds_label
    FOLDER = '/10 Datasources'
    DATASOURCENAME=ds_label
    OUTPUTSCHEMA (
        label_id = '"label_id"',
        label_name = '"label_name"'
    );

CREATE OR REPLACE TABLE bv_label I18N us_pst (
        label_id:int,
        label_name:text
    )
    FOLDER = '/20 Base views'
    CACHE OFF TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_label (
        I18N us_pst
        CONSTRAINTS (
             ADD label_id NOS ZERO ()
             ADD label_name NOS ZERO ()
        )
        OUTPUTLIST (label_id, label_name)
        WRAPPER (df ds_label)
    );

-- artist  <- data/artist.csv
CREATE OR REPLACE DATASOURCE DF ds_artist
    FOLDER = '/10 Datasources'
    ROUTE LOCAL 'LocalConnection' '@DATA_DIR@/artist.csv' FILENAMEPATTERN = ''
    CHARSET = 'UTF-8' COLUMNDELIMITER = ',' ENDOFLINEDELIMITER = '\n' HEADER = TRUE;

CREATE OR REPLACE WRAPPER DF ds_artist
    FOLDER = '/10 Datasources'
    DATASOURCENAME=ds_artist
    OUTPUTSCHEMA (
        artist_id = '"artist_id"',
        artist_name = '"artist_name"',
        label_id = '"label_id"'
    );

CREATE OR REPLACE TABLE bv_artist I18N us_pst (
        artist_id:int,
        artist_name:text,
        label_id:int
    )
    FOLDER = '/20 Base views'
    CACHE OFF TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_artist (
        I18N us_pst
        CONSTRAINTS (
             ADD artist_id NOS ZERO ()
             ADD artist_name NOS ZERO ()
             ADD label_id NOS ZERO ()
        )
        OUTPUTLIST (artist_id, artist_name, label_id)
        WRAPPER (df ds_artist)
    );

-- album  <- data/album.csv
CREATE OR REPLACE DATASOURCE DF ds_album
    FOLDER = '/10 Datasources'
    ROUTE LOCAL 'LocalConnection' '@DATA_DIR@/album.csv' FILENAMEPATTERN = ''
    CHARSET = 'UTF-8' COLUMNDELIMITER = ',' ENDOFLINEDELIMITER = '\n' HEADER = TRUE;

CREATE OR REPLACE WRAPPER DF ds_album
    FOLDER = '/10 Datasources'
    DATASOURCENAME=ds_album
    OUTPUTSCHEMA (
        album_id = '"album_id"',
        album_title = '"album_title"',
        artist_id = '"artist_id"'
    );

CREATE OR REPLACE TABLE bv_album I18N us_pst (
        album_id:int,
        album_title:text,
        artist_id:int
    )
    FOLDER = '/20 Base views'
    CACHE OFF TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_album (
        I18N us_pst
        CONSTRAINTS (
             ADD album_id NOS ZERO ()
             ADD album_title NOS ZERO ()
             ADD artist_id NOS ZERO ()
        )
        OUTPUTLIST (album_id, album_title, artist_id)
        WRAPPER (df ds_album)
    );

-- track  <- data/track.csv
CREATE OR REPLACE DATASOURCE DF ds_track
    FOLDER = '/10 Datasources'
    ROUTE LOCAL 'LocalConnection' '@DATA_DIR@/track.csv' FILENAMEPATTERN = ''
    CHARSET = 'UTF-8' COLUMNDELIMITER = ',' ENDOFLINEDELIMITER = '\n' HEADER = TRUE;

CREATE OR REPLACE WRAPPER DF ds_track
    FOLDER = '/10 Datasources'
    DATASOURCENAME=ds_track
    OUTPUTSCHEMA (
        track_id = '"track_id"',
        track_title = '"track_title"',
        album_id = '"album_id"',
        unit_price = '"unit_price"',
        cost_price = '"cost_price"'
    );

CREATE OR REPLACE TABLE bv_track I18N us_pst (
        track_id:int,
        track_title:text,
        album_id:int,
        unit_price:decimal,
        cost_price:decimal
    )
    FOLDER = '/20 Base views'
    CACHE OFF TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_track (
        I18N us_pst
        CONSTRAINTS (
             ADD track_id NOS ZERO ()
             ADD track_title NOS ZERO ()
             ADD album_id NOS ZERO ()
             ADD unit_price NOS ZERO ()
             ADD cost_price NOS ZERO ()
        )
        OUTPUTLIST (track_id, track_title, album_id, unit_price, cost_price)
        WRAPPER (df ds_track)
    );
